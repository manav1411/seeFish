{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seefish-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seefish-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "COMMUNITY_RECIPROCITY_ENABLED": "false" }
}
